{
  "apps": [
    {
      "name": "panchalii-api",
      "script": "src/index.js",
      "instances": "max",
      "exec_mode": "cluster",
      "env_production": {
        "NODE_ENV": "production",
        "PORT": 4000
      },
      "log_date_format": "YYYY-MM-DD HH:mm:ss",
      "error_file": "logs/err.log",
      "out_file": "logs/out.log",
      "merge_logs": true
    }
  ]
}
